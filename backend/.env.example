# Образец backend/.env для запуска у себя. На VPS те же переменные
# лежат в /etc/pismo-web.env (см. README).

PORT=5000
# HOST=127.0.0.1

# База. Без этих строк подключение берётся из ip.txt в корне проекта
# DB_HOST=5.181.23.167
# DB_PORT=3307
# DB_USER=user1
# DB_PASSWORD=
# DB_NAME=bdauth

# Звонки (LiveKit)
LIVEKIT_WS_URL=ws://5.181.23.167:7880
LIVEKIT_HTTP_URL=http://5.181.23.167:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# JWT_SECRET=  # по умолчанию тот же, что у ws-сервера
